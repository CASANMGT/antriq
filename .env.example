# ---------------------------------------------------------------------------
# AntriQ environment
# Copy to .env.local for development, or set these in Vercel.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, Vercel Postgres, local Docker).
# Use a database in Singapore (sin1) for Indonesian traffic.
# Local Docker from docker-compose.yml:
DATABASE_URL=postgres://antriq:antriq@localhost:5433/antriq

# Long random string used to sign staff session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL used in metadata and on the printable QR poster.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed demo queue entries on first boot. With 0 the demo brands, branches,
# staff and tables are still created on an empty database so you can sign in;
# the lived-in queue is skipped.
DEMO_MODE=1

# Staging: use a separate database and app URL per Vercel environment.
# Never point Preview/staging at the production database.

# Optional: use an in-memory / filesystem PGlite database instead of Postgres.
# Intended for local experiments and the test suite only. Do not use with
# multiple serverless instances.
# PGLITE_DATA_DIR=.data/pglite
